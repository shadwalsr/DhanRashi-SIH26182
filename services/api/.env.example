# Application Environment
ENVIRONMENT=development
DEMO_MODE=true
LIVE_MODE=false
API_V1_PREFIX=/api/v1
PROJECT_NAME="VASP-Trace"

# Security & Auth
SECRET_KEY=dev-secret-key-must-be-changed-in-production-at-least-32-chars-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL 15+)
DATABASE_URL=postgresql+asyncpg://vasp:vasp_secret@localhost:5432/vasp_trace
DATABASE_URL_SYNC=postgresql://vasp:vasp_secret@localhost:5432/vasp_trace

# Redis Cache & Queues
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Graph Expansion & Resilience Limits (FR-GRAPH-03)
DEFAULT_MAX_HOPS=3
GLOBAL_MAX_HOPS=5
MIN_TRACED_USD=100.0
MAX_TX_PER_NODE=200
MAX_NODES_PER_HOP=50
GLOBAL_NODE_CAP=1500
GLOBAL_EDGE_CAP=10000
HIGH_DEGREE_THRESHOLD=1000
CALL_BUDGET=600

# Blockchain Explorer & RPC Keys (Live Mode / Optional)
ETHERSCAN_API_KEY=
BSCSCAN_API_KEY=
POLYGONSCAN_API_KEY=
TRONGRID_API_KEY=
ETHEREUM_RPC_URL=
BNB_RPC_URL=
POLYGON_RPC_URL=
TRON_RPC_URL=
